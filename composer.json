{
  "type": "library",
  "name": "andrew-gos/helpers",
  "description": "Helpers",
  "homepage": "https://github.com/CiBeRHeMuL/Helpers",
  "authors": [
    {
      "name": "Andrey Gostev",
      "email": "Gostev71@outlook.com"
    }
  ],
  "license": "MIT",
  "keywords": [
    "andrew-gos",
    "php",
    "helpers",
    "strings",
    "dates"
  ],
  "minimum-stability": "stable",
  "require": {
    "php": "^8.4"
  },
  "suggest": {
    "ext-intl": "For using ICU formatter to format digit strings"
  },
  "require-dev": {
    "friendsofphp/php-cs-fixer": "^3.87",
    "phpunit/phpunit": "^12"
  },
  "config": {
    "sort-packages": true,
    "prefer-stable": true
  },
  "scripts": {
    "php-cs-fix": "php-cs-fixer fix",
    "php-cs-check": "php-cs-fixer check"
  },
  "autoload": {
    "psr-4": {
      "AndrewGos\\Helpers\\": "src"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "AndrewGos\\Helpers\\Tests\\": "tests"
    }
  }
}